{
  "name": "f1-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @f1/server\" \"npm run dev -w @f1/web\"",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.test.json --noEmit && tsc -p packages/openf1/tsconfig.test.json --noEmit && tsc -p apps/server/tsconfig.test.json --noEmit && tsc -p apps/web --noEmit && tsc -p scripts --noEmit",
    "fixture": "node scripts/fetch-fixture.mjs",
    "probe:live": "node scripts/probe-live.mjs",
    "mirror": "tsx scripts/mirror.ts",
    "build:pages": "npm run build -w @f1/web -- --mode pages",
    "e2e:mobile": "tsx scripts/e2e-mobile.ts",
    "icons": "tsx scripts/icons.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "radio-helper": "tsx scripts/radio-helper.ts",
    "transcribe:auto:install": "bash scripts/install-auto-transcribe.sh",
    "transcribe:auto:remove": "bash scripts/remove-auto-transcribe.sh",
    "transcribe:setup": "bash scripts/setup-whisper.sh",
    "e2e:pwa": "tsx scripts/e2e-pwa.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "fixture:schema": "tsx scripts/fixture-schema.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
